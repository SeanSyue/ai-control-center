[
  {
    "label": "N1 把產品辨識改成資料夾存在就放行",
    "file": "packaging/AI Control Center.iss",
    "replace": "Result := FileExists(AddBackslash(Dir) + '{#MyAppExeName}');",
    "with": "Result := DirExists(Dir);",
    "test": "tests/test_the_installer_only_moves_its_own_folder.py::test_ownership_is_proven_by_the_products_own_executable"
  },
  {
    "label": "N2 選資料夾那一頁不再擋（選到一個裝滿別的東西的資料夾也能按下一步）",
    "file": "packaging/AI Control Center.iss",
    "replace": "NotOursAndNotEmpty(WizardDirValue())",
    "with": "False",
    "test": "tests/test_the_installer_only_moves_its_own_folder.py::test_the_folder_page_refuses_a_foreign_folder"
  },
  {
    "label": "N3 安裝那一刻不再擋（無聲安裝跳過選資料夾那一頁，直接進來）",
    "file": "packaging/AI Control Center.iss",
    "replace": "if NotOursAndNotEmpty(ExpandConstant('{app}')) then",
    "with": "if False then",
    "test": "tests/test_the_installer_only_moves_its_own_folder.py::test_a_silent_install_is_stopped_too"
  },
  {
    "label": "N4 未辨認產品執行檔就搬移資料夾",
    "file": "packaging/AI Control Center.iss",
    "replace": "if IsAiccInstall(ExpandConstant('{app}')) then",
    "with": "if DirExists(ExpandConstant('{app}')) then",
    "test": "tests/test_the_installer_only_moves_its_own_folder.py::test_the_old_folder_is_only_renamed_when_it_is_an_aicc_install"
  },
  {
    "label": "N5 重新引入更新後刪除整個備份",
    "file": "packaging/AI Control Center.iss",
    "replace": "InstallCompleted := True;",
    "with": "InstallCompleted := True;\n    DelTree(BackupDir, True, True, True);",
    "test": "tests/test_the_installer_only_moves_its_own_folder.py::test_backups_and_partial_installations_are_not_deleted"
  },
  {
    "label": "N6 辨識後額外強制放行",
    "file": "packaging/AI Control Center.iss",
    "replace": "Result := FileExists(AddBackslash(Dir) + '{#MyAppExeName}');",
    "with": "Result := FileExists(AddBackslash(Dir) + '{#MyAppExeName}');\n  Result := True;",
    "test": "tests/test_the_installer_only_moves_its_own_folder.py::test_ownership_is_proven_by_the_products_own_executable"
  }
]
