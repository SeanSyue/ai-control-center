    "replace": "            # on the user clicking something first.\n            self._push_shell()\n            return",
    "with": "            # on the user clicking something first.\n            return",
    "test": "tests/test_activity_strip.py::test_a_background_ending_repaints_the_strip_without_waiting_for_a_click"
  },
  {
