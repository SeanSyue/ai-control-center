    "replace": "        \"outcome.VERIFY_NOT_CONFIGURED.label\",\n        \"partial\",",
    "with": "        \"outcome.VERIFY_NOT_CONFIGURED.label\",\n        \"gated\",",
    "test": "tests/test_main_window_runtime.py::test_the_stop_and_ask_survives_the_refresh_that_follows_it"
  },
  {
    "label": "N2 partial 從「什麼算結局」的白名單拿掉（抹除機制本體，兩個寫入點共用這一份）",
    "file": "app/ui/main_window.py",
    "replace": "OUTCOME_KINDS = (\"done\", \"error\", \"partial\")",
    "with": "OUTCOME_KINDS = (\"done\", \"error\")",
    "test": "tests/test_main_window_runtime.py::test_the_stop_and_ask_survives_the_refresh_that_follows_it"
  },
  {
