    "replace": "        if status_style in OUTCOME_KINDS:\n            session.last_outcome = (status_text, status_style)",
    "with": "        if False:\n            session.last_outcome = (status_text, status_style)",
    "test": "tests/test_activity_strip.py::test_a_run_that_stopped_to_ask_for_settings_is_in_the_strip"
  },
  {
