    "file": "app/core/outcomes.py",
    "replace": "        \"outcome.VERIFY_TIMED_OUT.label\",\n        \"partial\",",
    "with": "        \"outcome.VERIFY_TIMED_OUT.label\",\n        \"gated\",",
    "test": "tests/test_main_window_runtime.py::test_a_timed_out_verification_also_survives_the_refresh"
  },
