    "replace": "        if name == \"info\":",
    "with": "        if name in (\"info\", \"warn\"):",
    "test": "tests/test_the_page_alarm_is_heard.py::test_a_warning_from_the_page_reaches_somebody"
  },
  {
    "label": "K3 喊出來卻不講哪一頁哪一行（「有東西不對」寫進 stderr 等於沒寫——看到的人要知道去哪裡找）",
    "file": "app/ui/web_panel.py",
    "replace": "print(f\"[page {name}] {where}:{line} {message}\", file=sys.stderr)",
    "with": "print(f\"[page {name}] {message}\", file=sys.stderr)",
    "test": "tests/test_the_page_alarm_is_heard.py::test_it_says_which_page_and_which_line"
  },
  {
    "label": "K4 連 info 都端出來（頁面自己的除錯輸出會把真的警報淹掉——一個永遠在響的警報等於沒有警報）",
    "file": "app/ui/web_panel.py",
    "replace": "        if name == \"info\":\n            return",
    "with": "        if False:\n            return",
    "test": "tests/test_the_page_alarm_is_heard.py::test_the_page_chatter_does_not_drown_the_alarm"
  }
