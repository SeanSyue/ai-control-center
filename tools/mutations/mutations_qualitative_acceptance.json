    "replace": "MINIMUM_EXAMPLE_LENGTH = 8",
    "with": "MINIMUM_EXAMPLE_LENGTH = 0",
    "test": "tests/test_work_without_unit_tests_still_has_a_standard.py::test_an_abstract_example_is_rejected"
  },
  {
    "label": "Y4 沒寫 good 的案例被當成正例（一份漏寫的標準變成「沒有任何反例」——正是它沒有用的那個形狀）",
    "file": "app/services/qualitative_acceptance.py",
    "replace": "Example(good=bool(entry.get(\"good\", False)), text=str(entry.get(\"text\", \"\")))",
    "with": "Example(good=bool(entry.get(\"good\", True)), text=str(entry.get(\"text\", \"\")))",
    "test": "tests/test_work_without_unit_tests_still_has_a_standard.py::test_a_missing_good_flag_means_counter_example"
  },
  {
    "label": "Y5 前幾輪不提醒人核對（一份沒有被人核對過的標準，跟一個永遠回綠燈的測試是同一種東西）",
    "file": "app/services/qualitative_acceptance.py",
    "replace": "STILL_LEARNING_RUNS = 3",
    "with": "STILL_LEARNING_RUNS = 0",
    "test": "tests/test_work_without_unit_tests_still_has_a_standard.py::test_the_first_few_runs_ask_the_user_to_check_it"
  },
  {
    "label": "Y6 案例被摘要而不是逐字送過去（摘要做的正好是把具體案例壓回抽象描述）",
    "file": "app/core/prompt_builder.py",
    "replace": "            lines.append(f\"- {mark}：{example.text}\")",
    "with": "            lines.append(f\"- {mark}：（{len(example.text)} 字的案例）\")",
    "test": "tests/test_work_without_unit_tests_still_has_a_standard.py::test_the_examples_reach_the_prompt_verbatim"
  },
  {
    "label": "Y7 正例反例畫成一樣（反例會被當成範本照抄——你叫它不要做的事變成它的目標）",
    "file": "app/core/prompt_builder.py",
    "replace": "mark = \"✔ 這樣是對的\" if example.good else \"✘ 不准這樣\"",
    "with": "mark = \"案例\"",
    "test": "tests/test_work_without_unit_tests_still_has_a_standard.py::test_the_prompt_says_which_ones_are_forbidden"
