    "file": "app/core/prompt_builder.py",
    "replace": "        f\"{acceptance_rubric}{chr(10)}{chr(10)}\" if acceptance_rubric else \"\"",
    "with": "        f\"{acceptance_rubric}{chr(10)}{chr(10)}\" if acceptance_rubric else \"請依一般標準判斷。\" + chr(10)",
    "test": "tests/test_prompt_golden.py::test_every_prompt_matches_the_golden_snapshot"
  },
  {
    "label": "Y11 存標準的時候不驗（一份寫壞的標準進了檔案，而它看起來像已經設定好了）",
    "file": "app/services/qualitative_acceptance.py",
    "replace": "    problems = problems_with(rubric)\n    if problems:\n        raise RubricProblem(\"；\".join(problems))",
    "with": "    problems = []",
