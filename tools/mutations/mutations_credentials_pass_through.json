[
  {
    "label": "C1 「不知道」被當成「沒登入」（已經登入的人被叫去再登一次，然後開始懷疑畫面上每一句話）",
    "file": "app/services/credential_entry.py",
    "replace": "        if signed_in.get(provider) is False",
    "with": "        if signed_in.get(provider) is not True",
    "test": "tests/test_the_credential_door_cannot_take_a_key.py::test_not_knowing_is_not_the_same_as_signed_out"
  },
  {
    "label": "C2 不認得的 CLI 也硬給一個指令（他照著打，失敗訊息跟 AICC 無關，他以為是自己打錯）",
    "file": "app/services/credential_entry.py",
    "replace": "    return _ROUTES.get(provider.strip().lower())",
    "with": "    return _ROUTES.get(provider.strip().lower()) or _ROUTES[\"claude\"]",
    "test": "tests/test_the_credential_door_cannot_take_a_key.py::test_an_unknown_cli_gets_nothing_rather_than_a_guess"
  },
  {
    "label": "C3 有一支 CLI 沒有登入路徑（那一支的使用者卡在一個沒有出口的畫面）",
    "file": "app/services/credential_entry.py",
    "replace": "SUPPORTED = (\"claude\", \"codex\")",
    "with": "SUPPORTED = (\"claude\", \"codex\", \"gemini\")",
    "test": "tests/test_the_credential_door_cannot_take_a_key.py::test_every_supported_cli_has_a_way_in"
  },
  {
    "label": "C4 憑證入口開始收得下 key（AICC 從「帶路的手」變成「保管的人」，而畫面上只是多了一格輸入框）",
    "file": "app/services/credential_entry.py",
    "replace": "def route_for(provider: str) -> LoginRoute | None:",
    "with": "def save_api_key(provider: str, api_key: str) -> None:\n    raise NotImplementedError\n\n\ndef route_for(provider: str) -> LoginRoute | None:",
    "test": "tests/test_the_credential_door_cannot_take_a_key.py::test_no_function_here_can_even_accept_a_key"
  },
  {
    "label": "C5 沒登入只給一句話、不給按鈕（叫他離開 AICC 去終端機把一段看不懂的字打對）",
    "file": "app/services/startup_diagnostics.py",
    "replace": "            action=route.argv,",
    "with": "            action=(),",
    "test": "tests/test_the_credential_door_cannot_take_a_key.py::test_a_signed_out_cli_offers_a_button_not_just_a_sentence"
  },
  {
    "label": "C6 登入指令又變回寫死一份（會員優先改了憑證入口，畫面繼續叫他打舊指令）",
    "file": "app/services/startup_diagnostics.py",
    "replace": "            f\"在終端機執行：{route.typed}\",",
    "with": "            f\"在終端機執行：{typeable_name(provider)} auth login\",",
    "test": "tests/test_the_credential_door_cannot_take_a_key.py::test_the_login_line_has_exactly_one_source"
  },
  {
    "label": "C7 給人看的那一句不帶 .cmd（他貼進 PowerShell，撞上 UnauthorizedAccess 紅牆，而那面牆不會提到 Claude）",
    "file": "app/services/credential_entry.py",
    "replace": "        return \" \".join((typeable_name(self.argv[0]), *self.argv[1:]))",
    "with": "        return \" \".join(self.argv)",
    "test": "tests/test_startup_diagnostics.py::test_the_sign_in_instruction_runs_under_a_restricted_execution_policy"
  },
  {
    "label": "C8 黑視窗的放行記號被貼到沒有人看過的檔案（守衛閉嘴，使用者多一個閃出來的黑框）",
    "file": "app/services/session_scanner.py",
    "replace": "from __future__ import annotations",
    "with": "from __future__ import annotations  # SHOWS_A_WINDOW_ON_PURPOSE",
    "test": "tests/test_no_black_windows_flash.py::test_the_marker_is_only_used_where_a_window_is_the_whole_point"
  },
  {
    "label": "C9 清單留著一個已經不開視窗的地方（過期的放行＝替下一個人先開好一扇門）",
    "file": "app/ui/text_view_dialog.py",
    "replace": "SHOWS_A_WINDOW_ON_PURPOSE",
    "with": "SHOWS_A_WINDOW_DELIBERATELY",
    "test": "tests/test_no_black_windows_flash.py::test_the_marker_is_only_used_where_a_window_is_the_whole_point"
  }
]
