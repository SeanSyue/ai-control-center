    "replace": "        return t(\"time.minutes\", n=minutes)",
    "with": "        return t(\"time.minutes_ago\", n=minutes)",
    "test": "tests/test_how_long_ago_is_said_one_way.py::test_the_words_for_how_long_it_took"
  },
  {
