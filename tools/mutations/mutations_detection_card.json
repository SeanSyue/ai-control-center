    "replace": "from dataclasses import dataclass",
    "with": "import subprocess\nfrom dataclasses import dataclass",
    "test": "tests/test_the_detection_card_says_how_sure_it_is.py::test_detection_runs_nothing_and_writes_nothing"
  },
  {
    "label": "D6 有一格不講憑什麼（這張卡變成一份不知道從哪來的設定，他只能全部相信或全部重填）",
    "file": "app/services/project_detection.py",
    "replace": "                t(\"detect.because.saw_marker\", marker=marker),\n                LIKELY,",
    "with": "                \"\",\n                LIKELY,",
    "test": "tests/test_the_detection_card_says_how_sure_it_is.py::test_every_cell_says_what_it_is_and_why"
